# ros_debug auto-debug 部署配置（仅 scripts/auto_debug_match.py + scripts/debug_*
# + scripts/manual_match 读取）。
# 容器里跑的 SoccerSimAgent / soccer_sim_node 不读这里的字段。
# 复制到 ros_debug/.soccer_sim.env 后按本机环境修改。
SOCCER_DOCKER_CONTAINER=c972daf7bf19
SOCCER_DOCKER_WORKDIR=/root/workspace/SoccerSim
SOCCER_DOCKER_ROS_SETUP=/opt/ros/humble/setup.bash
SOCCER_DOCKER_EXTRA_SETUP=
SOCCER_FASTDDS_PROFILE=/opt/booster/BoosterRos2/fastdds_profile.xml
SOCCER_GAME_CONTROL_URL=http://127.0.0.1:38383
SOCCER_GAME_CONTROL_ARTIFACT_DIR=/usr/local/booster_robot/booster_robocup_sim/logs/game-control
